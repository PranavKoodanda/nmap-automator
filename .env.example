FRONTEND_CORS_ORIGINS=http://localhost:5173
APP_ENV=development
APP_ACCESS_PASSWORD=replace-with-a-long-local-password
APP_AUTH_SECRET=replace-with-at-least-32-random-bytes
APP_AUTH_TOKEN_TTL_SECONDS=3600
APP_LOGIN_ATTEMPT_LIMIT=5
APP_LOGIN_WINDOW_SECONDS=300
# Optional in development; production requires explicitly authorized targets.
SCAN_TARGET_ALLOWLIST=127.0.0.1,localhost
