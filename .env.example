FRONTEND_CORS_ORIGINS=http://localhost:5173
APP_ENV=development
APP_AUTH_SECRET=replace-with-at-least-32-random-bytes
APP_CAPABILITY_TTL_SECONDS=3600
DOMAIN_CHALLENGE_TTL_SECONDS=600
PUBLIC_RATE_WINDOW_SECONDS=3600
DOMAIN_CHALLENGE_LIMIT=10
DOMAIN_VERIFICATION_LIMIT=20
SCAN_SUBMISSION_LIMIT=20
# Optional extra hostname restriction. DNS ownership and public-IP checks always apply.
SCAN_TARGET_ALLOWLIST=
