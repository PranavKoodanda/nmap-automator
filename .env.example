FRONTEND_CORS_ORIGINS=http://localhost:5173
APP_ENV=development
# Generate a private value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Paste the generated value into .env; do not commit .env or place this in a VITE_ variable.
APP_AUTH_SECRET=
APP_CAPABILITY_TTL_SECONDS=86400
PUBLIC_RATE_WINDOW_SECONDS=3600
ANONYMOUS_SESSION_LIMIT=30
SCAN_SUBMISSION_LIMIT=20
MAX_CONCURRENT_SCANS=2
MAX_PENDING_SCANS=4
# Optional additional restriction on submitted target or resolved IP.
SCAN_TARGET_ALLOWLIST=
